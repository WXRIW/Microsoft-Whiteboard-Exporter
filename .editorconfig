root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,slnx,xaml,json,mjs,js,css,html,svg,yml,yaml}]
indent_size = 2

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[docs/licenses/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
charset = unset
