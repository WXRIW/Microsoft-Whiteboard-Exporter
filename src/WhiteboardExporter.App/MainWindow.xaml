<Window x:Class="WhiteboardExporter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="微软白板导出器" Width="1320" Height="880" MinWidth="1000" MinHeight="680" Background="#F4F7FB" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="白板导出器" FontSize="26" FontWeight="SemiBold" Foreground="#172B4D"/>
        <TextBlock Text="把画布留在本机 · 原始备份、离线重绘与多格式导出" Margin="0,5,0,0" Foreground="#64748B"/>
      </StackPanel>
      <TextBlock Text="WINDOWS · LOCAL" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B" FontSize="11"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="ImportButton" Content="导入文件" Click="Import_Click"/>
        <Button x:Name="OpenDirectoryButton" Content="打开目录…" Click="OpenDirectory_Click"/>
        <Button x:Name="SampleButton" Content="示例白板" Click="Sample_Click"/>
        <Button x:Name="LoginButton" Content="微软网页登录" Click="Login_Click"/>
        <Button x:Name="RefreshButton" Content="读取白板列表" Click="Refresh_Click"/>
        <Button x:Name="LogoutButton" Content="退出账号" Click="Logout_Click"/>
      </StackPanel>
      <Button Content="查看导出文件夹" Click="OpenOutput_Click" HorizontalAlignment="Right" Margin="0"/>
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="242"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="10" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="我的白板" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="LibraryLocationText" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="按标题或 ID 搜索" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="全选" Click="SelectAll_Click" Padding="8,4"/><Button Content="清除选择" Click="ClearSelection_Click" Padding="8,4"/></StackPanel>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="按住 Ctrl / Shift 可以多选" Foreground="#64748B" FontSize="11" Margin="0,10,0,0"/>
          <ListBox x:Name="BoardList" SelectionMode="Extended" SelectionChanged="Board_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,7" Width="192" ToolTip="{Binding Id}"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding AccountLabel}" Foreground="#1565C0" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding IdLabel}" Foreground="#64748B" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="{Binding Subtitle}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding ModifiedLabel}" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="10" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <TextBlock x:Name="BoardTitle" Text="选择或导入一张白板" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Click="ZoomOut_Click" Padding="9,4"/><Button Content="＋" Click="ZoomIn_Click" Padding="9,4"/><Button Content="适应窗口" Click="Fit_Click" Padding="9,4" Margin="0"/></StackPanel>
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock x:Name="BoardMetadataText" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="OriginalPreviewButton" Content="原始重绘" Click="OriginalPreview_Click" Padding="8,3" IsEnabled="False"/><Button x:Name="HtmlPreviewButton" Content="离线 HTML" Click="HtmlPreview_Click" Padding="8,3" IsEnabled="False"/><Button x:Name="SvgPreviewButton" Content="SVG" Click="SvgPreview_Click" Padding="8,3" IsEnabled="False"/></StackPanel></StackPanel>
          <TabControl x:Name="PreviewTabs" Grid.Row="2" BorderThickness="0" SelectionChanged="Preview_Changed">
            <TabItem Header="原始重绘" x:Name="SceneTab"><wv:WebView2 x:Name="SceneView"/></TabItem>
            <TabItem Header="PDF" x:Name="PdfTab"><wv:WebView2 x:Name="PdfView"/></TabItem>
            <TabItem Header="图片" x:Name="ImageTab"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#EDF1F6" PreviewMouseWheel="Image_MouseWheel"><Image x:Name="ImagePreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform></Image></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal"><ComboBox x:Name="ImageFileBox" MinWidth="120" MaxWidth="280" DisplayMemberPath="Name" SelectionChanged="ImageFile_Changed"/><TextBlock x:Name="ImageDetails" Foreground="#64748B" FontSize="11" Margin="6"/></StackPanel></Grid></TabItem>
            <TabItem Header="网页登录" x:Name="LoginTab"><wv:WebView2 x:Name="CloudView"/></TabItem>
          </TabControl>
        </Grid>
      </Border>
      <Border Grid.Column="4" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="10" Padding="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="导出设置" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14"/>
            <TextBlock Text="输出目录" Foreground="#64748B" Margin="0,0,0,5"/>
            <TextBox x:Name="OutputBox" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <Button Content="选择目录…" Click="ChooseOutput_Click" Margin="0,0,0,15"/>
            <TextBlock x:Name="AccountInfoText" Text="账号目录：本地导入" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBox x:Name="AccountDirectoryBox" ToolTip="账号通常自动识别。无法识别时，请为当前登录账号填写独立目录名称。" Margin="0,0,0,12"/>
            <TextBlock Text="文件格式" Foreground="#64748B" Margin="0,0,0,5"/>
            <WrapPanel Margin="0,0,0,12">
              <CheckBox x:Name="FormatArchive" Content="原始备份" IsChecked="True" Margin="0,0,12,8"/>
              <CheckBox x:Name="FormatJson" Content="JSON" IsChecked="True" Margin="0,0,12,8"/>
              <CheckBox x:Name="FormatPdf" Content="PDF" IsChecked="True" Margin="0,0,12,8"/>
              <CheckBox x:Name="FormatPng" Content="PNG" IsChecked="True" Margin="0,0,12,8"/>
              <CheckBox x:Name="FormatJpeg" Content="JPEG" Margin="0,0,12,8"/>
              <CheckBox x:Name="FormatSvg" Content="SVG" Margin="0,0,12,8"/>
              <CheckBox x:Name="FormatHtml" Content="离线 HTML" IsChecked="True" Margin="0,0,12,8"/>
            </WrapPanel>
            <TextBlock Text="PDF 排版" Foreground="#64748B" Margin="0,0,0,5"/>
            <ComboBox x:Name="PdfLayoutBox" SelectedIndex="0"><ComboBoxItem Content="整张白板 · 动态纸张单页" Tag="Canvas"/><ComboBoxItem Content="A4 横向 · 整板单页" Tag="A4Fit"/><ComboBoxItem Content="A3 横向 · 整板单页" Tag="A3Fit"/><ComboBoxItem Content="A4 · 分页铺满" Tag="A4Tiles"/></ComboBox>
            <TextBlock Text="图片缩放比例" Foreground="#64748B" Margin="0,0,0,5"/>
            <ComboBox x:Name="ImageScaleBox" SelectedIndex="4">
              <ComboBoxItem Content="10%" Tag="0.1"/><ComboBoxItem Content="25%" Tag="0.25"/>
              <ComboBoxItem Content="50%" Tag="0.5"/><ComboBoxItem Content="75%" Tag="0.75"/>
              <ComboBoxItem Content="100%（原画板尺寸）" Tag="1"/><ComboBoxItem Content="125%" Tag="1.25"/>
              <ComboBoxItem Content="150%" Tag="1.5"/><ComboBoxItem Content="200%" Tag="2"/>
              <ComboBoxItem Content="300%" Tag="3"/><ComboBoxItem Content="400%" Tag="4"/>
              <ComboBoxItem Content="500%" Tag="5"/><ComboBoxItem Content="800%" Tag="8"/>
              <ComboBoxItem Content="1000%" Tag="10"/>
            </ComboBox>
            <TextBlock Text="宽、高最多 20000 像素，超出后自动等比缩小。" TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>
            <CheckBox x:Name="TransparentBox" Content="PNG 透明背景" IsChecked="True" Margin="0,0,0,16"/>
            <Button x:Name="ExportButton" Content="导出选中白板" Background="#1565C0" Foreground="White" BorderThickness="0" Click="Export_Click" Margin="0,0,0,8"/>
            <Button Content="重试失败任务" Click="Retry_Click" Margin="0,0,0,8"/>
            <Button x:Name="CancelButton" Content="取消当前任务" Click="Cancel_Click" IsEnabled="False" Margin="0,0,0,16"/>
            <TextBlock Text="内容检查" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock x:Name="DiagnosticsText" Text="导入后显示对象数量和缺失内容。" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar x:Name="TaskProgress" Height="4" Minimum="0" Maximum="100"/><TextBlock x:Name="StatusText" Text="正在初始化本地预览…" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    <wv:WebView2 x:Name="ExportView" Grid.Row="4" Width="1" Height="1" HorizontalAlignment="Left" IsHitTestVisible="False"/>
  </Grid>
</Window>
