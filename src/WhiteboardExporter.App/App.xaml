<Application x:Class="WhiteboardExporter.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#1565C0" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,8" /><Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#172B4D" /><Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7" /><Setter Property="BorderBrush" Value="#CBD5E1" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style TargetType="TabItem"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,6" /></Style>
  </Application.Resources>
</Application>
